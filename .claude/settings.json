{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "git pull --ff-only || echo 'git pull failed - sync manually before editing'" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python scripts/validate.py || true" }
        ]
      }
    ]
  }
}
